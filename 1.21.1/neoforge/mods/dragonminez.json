{
  "mod_id": "dragonminez",
  "mod_name": "DragonMine Z",
  "home_page": "https://www.curseforge.com/minecraft/mc-mods/dragonminez",
  "contributors": [
    "ifels"
  ],
  "config_version": "1.0.0",
  "mod_versions": [
    {
      "version": "",
      "ignoreKeys": [],
      "phasePersistentKeys": {
        "key.dragonminez.utility_menu": [
          "inGame",
          "screen"
        ]
      },
      "inGameKeys": {
        "key.dragonminez.utility_menu": {
          "channels": [
            "keyMapping",
            "glfwPoll",
            "screenInput"
          ]
        }
      },
      "overlayKeys": {
        "key.dragonminez.utility_menu": {}
      },
      "screenKeys": {
        "key.dragonminez.utility_menu": {
          "channels": [
            "keyMapping",
            "glfwPoll",
            "screenInput"
          ]
        }
      },
      "tips": [
        {
          "key": "key.dragonminez.utility_menu",
          "text": {
            "en_us": "Hold to open the DragonMineZ utility menu. Use HOLD mode only. Do not bind the same button as a layer-switch key."
          }
        }
      ],
      "screen": {
        "com.dragonminez.client.gui.UtilityMenuScreen": {
          "leftStick": {
            "behavior": "VIRTUAL_MOUSE"
          },
          "rightStick": {
            "behavior": "RADIAL_PATH",
            "threshold": 0.5,
            "cursorRadius": 90,
            "angleBias": 1.0
          }
        }
      }
    }
  ]
}
